# Copy to .env.local only when overriding deployment destinations.
# Blank values use the defaults in src/content/links.ts.
# Development: current browser protocol/hostname, port 3000, /nx and /verify.
# This keeps localhost, LAN IPv4/IPv6 and configured HTTPS hosts aligned.
# Production: same-origin /nx and /verify unless explicitly configured below.

# Absolute or same-origin relative URL of the Decision Evidence Demo.
VITE_DEMO_URL=

# Absolute or same-origin relative URL of the independent Verifier.
VITE_VERIFIER_URL=

# Verification uses Web Crypto: a phone accessing the LAN needs trusted HTTPS
# for Analyze. HTTP LAN supports navigation/transport, not cryptographic checks.
# Setting an HTTPS URL does not provision a certificate or change the servers.

# Absolute URL of the published documentation site, if one exists.
# Left unset renders the Documentation link as "not yet available".
VITE_DOCS_URL=

# Absolute URL of the public GitHub repository, if one exists.
# Left unset renders the GitHub link as "not yet available".
VITE_GITHUB_URL=
