# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.dev-server.*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
# Generated-media staging, including ImageGen drafts. Promote reviewed assets
# explicitly into public/; do not generate directly into canonical source.
/outputs/
/work/

# Generated framework/cache outputs
/next-env.d.ts
/tsconfig.tsbuildinfo

# D-006A snapshot generator outputs
/app/.snapshot-*.mjs
/scripts/d006a/snapshots/snapshot-*.html
/scripts/d006a/snapshots/snapshot.css
